POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aggr_system
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

SECRET_KEY=replace-with-a-long-random-value
API_SUPERUSER_TOKEN=replace-with-an-api-token

CRPT_THUMBPRINT=replace-with-certificate-thumbprint
OMS_ID=replace-with-oms-id
OMS_CONN_ID=replace-with-oms-connection-id
CRPT_SANDBOX=true
CRPT_MOCK_MODE=false
CRPT_SIGNER_MODE=remote
CRPT_SIGNER_URL=http://host.docker.internal:8010
CRPT_SIGNER_TOKEN=replace-with-a-signer-token

GS1_PREFIX=replace-with-gs1-prefix
GS1_EXTENSION_DIGIT=0

DEBUG=false
ENVIRONMENT=development
LABELS_DIR=/app/labels
LOG_DIR=logs
LOG_FILE=app.log
